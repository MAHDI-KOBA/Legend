int hashing(const char* str) {

	int hashing = 5381;

	int c;

	while (c = *str++) {

		hashing = ((hashing << 5) + hashing) + c; /* hash * 33 + c */

		if (hashing < 0) hashing = 100;

	}

	if (hashing < 0) hashing = 100;

	return hashing;

}



