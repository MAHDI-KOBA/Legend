                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <ImageView
                android:id="@+id/icon_clear_search_text"
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_10sdp"
