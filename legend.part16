PK␀␀␀␀␀üTx]§È¢¢÷␀␀÷␀␀`␀␀␀samp-android-launcher-32-64bit-1.1.3/app/src/main/cpp/multiplayer/gui/samp_widgets/buttonpanel.h#pragma once

// Left-side button panel: [>>][TAB]  ->  tap ">>" and the rest slides open from left to right:
// [<<][TAB][ALT][H][Y][N][G][F]
class ButtonPanel : public Widget
{
public:
    ButtonPanel();

    virtual void draw(ImGuiRenderer* renderer) override;
    virtual void performLayout() override;

    IconButton* m_bH;
    IconButton* m_bAlt;
    IconButton* m_bY;
    IconButton* m_bN;
    IconButton* m_bG;
    IconButton* m_bF;
    IconButton* m_bTab;
    IconButton* m_bOpen;   // >>
    IconButton* m_bClose;  // <<

private:
    void layoutButtons(float reveal);

    bool m_open;
    float m_reveal;          // 0 = collapsed, 1 = fully open
    uint32_t m_lastTick;
    float m_btn;             // button size in pixels
    float m_gap;
};
PK␀␀␀␀␀Ux]>ßºè␀␀è␀␀b␀␀␀samp-android-launcher-32-64bit-1.1.3/app/src/main/cpp/multiplayer/gui/samp_widgets/buttonpanel.cpp#include "../../main.h"
#include "../gui.h"
#include "../../game/game.h"
#include "../../net/netgame.h"
#include "../../net/localplayer.h"
#include "../widgets/ui_icons.h"
#include <chrono>

extern UI* pUI;
extern CNetGame* pNetGame;
extern CGame *pGame;

bool bNeedEnterVehicle = false;
bool OpenButton = false;
int Tab = 0;

static uint32_t PanelNowMs()
{
    return (uint32_t)std::chrono::duration_cast<std::chrono::milliseconds>(
            std::chrono::steady_clock::now().time_since_epoch()).count();
}

ButtonPanel::ButtonPanel()
{
    m_open = false;
    m_reveal = 0.0f;
    m_lastTick = 0;
    m_btn = 0.0f;
    m_gap = 0.0f;

    m_bOpen  = new IconButton(UI_ICON_OPEN,  UI_ICON_SIZE, UI_ICON_SIZE);
    m_bClose = new IconButton(UI_ICON_CLOSE, UI_ICON_SIZE, UI_ICON_SIZE);
    m_bTab   = new IconButton(UI_ICON_TAB,   UI_ICON_SIZE, UI_ICON_SIZE);
    m_bAlt   = new IconButton(UI_ICON_ALT,   UI_ICON_SIZE, UI_ICON_SIZE);
    m_bH     = new IconButton(UI_ICON_H,     UI_ICON_SIZE, UI_ICON_SIZE);
    m_bY     = new IconButton(UI_ICON_Y,     UI_ICON_SIZE, UI_ICON_SIZE);
    m_bN     = new IconButton(UI_ICON_N,     UI_ICON_SIZE, UI_ICON_SIZE);
    m_bG     = new IconButton(UI_ICON_G,     UI_ICON_SIZE, UI_ICON_SIZE);
    m_bF     = new IconButton(UI_ICON_F,     UI_ICON_SIZE, UI_ICON_SIZE);

    m_bOpen->setCallback([this]() {
        m_open = true;
        OpenButton = true;
    });

    m_bClose->setCallback([this]() {
        m_open = false;
        OpenButton = false;
    });

    // TAB: opens the player list; it is closed with the X button of the list window itself
    m_bTab->setCallback([this]() {
        if (pUI && pUI->playertablist()) {
            pUI->playertablist()->show();
            Tab = 1;
        }
    });

    m_bAlt->setCallback([this]() { LocalPlayerKeys.bKeys[ePadKeys::KEY_WALK] = true; });
    m_bH->setCallback([this]()   { LocalPlayerKeys.bKeys[ePadKeys::KEY_CTRL_BACK] = true; });
    m_bY->setCallback([this]()   { LocalPlayerKeys.bKeys[ePadKeys::KEY_YES] = true; });
    m_bN->setCallback([this]()   { LocalPlayerKeys.bKeys[ePadKeys::KEY_NO] = true; });
    m_bF->setCallback([this]()   { LocalPlayerKeys.bKeys[ePadKeys::KEY_SECONDARY_ATTACK] = true; });
    m_bG->setCallback([this]()   { bNeedEnterVehicle = true; });

    m_bClose->setVisible(false);
    m_bAlt->setVisible(false);
    m_bH->setVisible(false);
    m_bY->setVisible(false);
    m_bN->setVisible(false);
    m_bG->setVisible(false);
    m_bF->setVisible(false);

    this->addChild(m_bOpen);
    this->addChild(m_bClose);
    this->addChild(m_bTab);
    this->addChild(m_bAlt);
    this->addChild(m_bH);
    this->addChild(m_bY);
    this->addChild(m_bN);
    this->addChild(m_bG);
    this->addChild(m_bF);
}

void ButtonPanel::performLayout()
{
    // button size relative to screen height (about 7.5% of it)
    float screenH = UISettings::m_displaySize.y;
    if (screenH <= 0.0f) screenH = 1080.0f;

    m_btn = screenH * 0.075f;
    m_gap = m_btn * 0.12f;

    layoutButtons(m_reveal);
}

void ButtonPanel::layoutButtons(float reveal)
{
    if (m_btn <= 0.0f) return;

    const float slot = m_btn + m_gap;
    const int extCount = 6; // ALT H Y N G F
    const float extW = slot * extCount;

    IconButton* ext[extCount] = { m_bAlt, m_bH, m_bY, m_bN, m_bG, m_bF };

    ImVec2 sz(m_btn, m_btn);
    m_bOpen->setFixedSize(sz);
    m_bClose->setFixedSize(sz);
    m_bTab->setFixedSize(sz);

    m_bOpen->setPosition(ImVec2(0.0f, 0.0f));
    m_bClose->setPosition(ImVec2(0.0f, 0.0f));
    m_bTab->setPosition(ImVec2(slot, 0.0f));

    // extra buttons slide out from behind TAB (left -> right)
    for (int i = 0; i < extCount; i++) {
        ext[i]->setFixedSize(sz);
        ext[i]->setPosition(ImVec2(slot * 2 + slot * i - (1.0f - reveal) * extW, 0.0f));
    }

    this->setFixedSize(ImVec2(slot * 2 + extW * reveal, m_btn));
}

void ButtonPanel::draw(ImGuiRenderer* renderer)
{
    if (m_btn <= 0.0f) performLayout();

    // animate (about 200 ms)
    uint32_t now = PanelNowMs();
    float dt = m_lastTick ? (float)(now - m_lastTick) / 1000.0f : 0.0f;
    m_lastTick = now;
    if (dt > 0.1f) dt = 0.1f;

    const float speed = 1.0f / 0.20f;
    if (m_open)  { m_reveal += dt * speed; if (m_reveal > 1.0f) m_reveal = 1.0f; }
    else         { m_reveal -= dt * speed; if (m_reveal < 0.0f) m_reveal = 0.0f; }

    layoutButtons(m_reveal);

    const bool showExt = m_open || m_reveal > 0.001f;
    IconButton* ext[6] = { m_bAlt, m_bH, m_bY, m_bN, m_bG, m_bF };
    // touchable only once fully open (they are still drawn while sliding)
    for (int i = 0; i < 6; i++) ext[i]->setVisible(m_open && m_reveal >= 0.999f);

    // ">>" when closed, "<<" when open (or opening)
    m_bOpen->setVisible(!m_open);
    m_bClose->setVisible(m_open);

    // base buttons
    m_bOpen->draw(renderer);
    m_bClose->draw(renderer);
    m_bTab->draw(renderer);

    // sliding buttons are clipped to the area to the right of TAB
    if (showExt) {
        const float slot = m_btn + m_gap;
        ImVec2 base = absolutePosition();
        ImVec2 cmin(base.x + slot * 2, base.y - 2.0f);
        ImVec2 cmax(base.x + slot * 2 + slot * 6 * m_reveal + 1.0f, base.y + m_btn + 2.0f);

        renderer->pushClipRect(cmin, cmax, true);
        for (int i = 0; i < 6; i++) ext[i]->draw(renderer);
        renderer->popClipRect();
    }
}
PK␀␀␀␀␀Ux]Ñôr| ␀␀ ␀␀`␀␀␀samp-android-launcher-32-64bit-1.1.3/app/src/main/cpp/multiplayer/gui/samp_widgets/voicebutton.h#pragma once
#include "../../game/game.h"
#include "../../game/util.h"

#include "../../main.h"

#include "../../settings.h"
#include "util/CUtil.h"
#include "../widgets/ui_icons.h"

extern CSettings* pSettings;

// Microphone button. One tap = start talking (microphone turns red), one more tap = stop.
class VoiceButton : public Widget
{
public:
	VoiceButton() : Widget()
	{
		m_recording = false;
		m_texOff = nullptr;
		m_texOn = nullptr;
		m_texFailed = false;
	}

	virtual void draw(ImGuiRenderer* renderer) override
	{
		if(!pSettings || !pSettings->Get().bVoiceChatEnable) return;

		// icons are embedded in the app; create the textures lazily on the render thread
		if (!m_texOff && !m_texOn && !m_texFailed) {
			m_texOff = UI_CreateRasterRGBA(UI_ICON_MIC, UI_ICON_SIZE, UI_ICON_SIZE);
			m_texOn  = UI_CreateRasterRGBA(UI_ICON_MIC_ON, UI_ICON_SIZE, UI_ICON_SIZE);
			if (!m_texOff || !m_texOn) m_texFailed = true;
		}

		RwRaster* tex = m_recording ? m_texOn : m_texOff;
		if (tex) {
			renderer->drawImage(absolutePosition(), absolutePosition() + size(), (ImTextureID)tex);
		} else {
			// fallback if the texture could not be created: red/dark circle
			renderer->drawRoundedRect(absolutePosition(), absolutePosition() + size(),
				m_recording ? ImColor(1.0f, 0.1f, 0.1f, 1.0f) : ImColor(0.17f, 0.10f, 0.16f, 1.0f), size().x * 0.5f, true);
		}
	}

	// toggle on release (a tap), no need to keep holding
	void touchPopEvent() override
	{
		setRecording(!m_recording);
	}

	void setRecording(bool recording)
	{
		m_recording = recording;
	}

	bool recording() const { return m_recording; }

private:
	bool m_recording;
	RwRaster* m_texOff;
	RwRaster* m_texOn;
	bool m_texFailed;
};
